# Spider On on an ordinary Apache web host (spec chapter 15).
# Vite copies this file from public/ into the build; upload it with the rest.
# Every block is wrapped in <IfModule>, so a host without a module still serves the game.

Options -Indexes
DirectoryIndex index.html

# A service worker and the installable app work only over HTTPS.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Older hosts do not know these types; a wrong one breaks modules, the manifest or the font.
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddCharset utf-8 .js .css .html .webmanifest .svg
</IfModule>

<IfModule mod_headers.c>
  # The page, the worker and the manifest must always be checked with the server,
  # otherwise players would not learn about a new version.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Files in assets/ carry a hash of their content in the name, so they never change.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
